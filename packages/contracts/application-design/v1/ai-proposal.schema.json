            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "remove_object"
              },
              "collection": {
                "const": "navigation"
              },
              "target_id": {
                "$ref": "urn:campus:application-design:v1:application#/$defs/id"
              }
            },
            "required": [
              "operation",
              "collection",
              "target_id"
            ]
          }
        ]
      },
      "minItems": 0,
      "maxItems": 50
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:campus:application-design:v1:application#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "blocking": {
            "const": true
          },
          "suggested_answers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "minItems": 0,
            "maxItems": 5
          }
        },
        "required": [
          "id",
          "text",
          "blocking",
          "suggested_answers"
        ]
      },
      "minItems": 0,
      "maxItems": 10
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:campus:application-design:v1:application#/$defs/id"
          },
          "kind": {
            "enum": [
              "capability",
              "data",
              "identity",
              "business_rule"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "capability_id": {
            "$ref": "urn:campus:application-design:v1:application#/$defs/capabilityId"
          }
        },
        "required": [
          "id",
          "kind",
          "description"
        ]
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "application_id",
    "base_revision",
    "base_content_hash",
    "catalog_hash",
    "status",
    "summary",
    "operations",
    "questions",
    "requirements"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "properties": {
          "operations": {
            "maxItems": 0
          },
          "questions": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "operations": {
            "minItems": 1
          },
          "questions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "properties": {
                "operation": {
                  "const": "create_application"
                }
              },
              "required": [
                "operation"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "base_revision": {
            "const": 0
          },
          "operations": {
            "maxItems": 1
          }
        }
      }
    }
  ]
}
