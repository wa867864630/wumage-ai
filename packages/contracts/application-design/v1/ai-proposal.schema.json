            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "remove_object"
              },
              "collection": {
                "const": "models"
              },
              "target_id": {
                "$ref": "urn:campus:application-design:v1:application#/$defs/id"
              }
            },
            "required": [
              "operation",
              "collection",
              "target_id"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "add_object"
              },
              "collection": {
                "const": "forms"
              },
              "value": {
