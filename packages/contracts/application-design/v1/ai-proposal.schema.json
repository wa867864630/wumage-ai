{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:campus:application-design:v1:ai-proposal",
  "title": "AI design proposal 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "$ref": "urn:campus:application-design:v1:application#/$defs/id"
    },
    "application_id": {
      "$ref": "urn:campus:application-design:v1:application#/$defs/id"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0
    },
    "base_content_hash": {
      "$ref": "urn:campus:application-design:v1:application#/$defs/digest"
    },
    "catalog_hash": {
      "$ref": "urn:campus:application-design:v1:application#/$defs/digest"
    },
    "status": {
      "enum": [
        "proposed",
        "needs_clarification"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "create_application"
              },
              "value": {
                "$ref": "urn:campus:application-design:v1:application"
              }
            },
            "required": [
              "operation",
