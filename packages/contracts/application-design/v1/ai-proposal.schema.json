            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "set_required_capabilities"
              },
              "capability_ids": {
                "type": "array",
                "items": {
                  "$ref": "urn:campus:application-design:v1:application#/$defs/capabilityId"
                },
                "minItems": 0,
                "maxItems": 200,
                "uniqueItems": true
              }
            },
            "required": [
              "operation",
              "capability_ids"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "replace_control"
              },
              "form_id": {
                "$ref": "urn:campus:application-design:v1:application#/$defs/id"
              },
              "control_id": {
                "$ref": "urn:campus:application-design:v1:application#/$defs/id"
              },
              "value": {
                "$ref": "urn:campus:application-design:v1:application#/$defs/control"
              }
            },
            "required": [
              "operation",
              "form_id",
              "control_id",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "reorder_controls"
              },
              "form_id": {
                "$ref": "urn:campus:application-design:v1:application#/$defs/id"
              },
              "section_id": {
                "$ref": "urn:campus:application-design:v1:application#/$defs/id"
              },
              "control_ids": {
                "type": "array",
                "items": {
                  "$ref": "urn:campus:application-design:v1:application#/$defs/id"
                },
                "minItems": 1,
                "maxItems": 50,
                "uniqueItems": true
              }
            },
            "required": [
              "operation",
              "form_id",
              "section_id",
              "control_ids"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "add_object"
              },
              "collection": {
                "const": "models"
              },
              "value": {
                "$ref": "urn:campus:application-design:v1:application#/$defs/model"
              }
            },
            "required": [
