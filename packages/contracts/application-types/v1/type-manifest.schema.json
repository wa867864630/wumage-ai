{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:campus:application-types:v1:manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0.0"
    },
    "type_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "type_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "family": {
      "enum": [
        "query",
        "form",
        "approval",
        "dashboard"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "config_schema_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^urn:campus:[a-zA-Z0-9:._-]+$"
    },
    "config_schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "runtime_adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "editor_sections": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "editor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          }
        },
        "required": [
          "id",
          "title",
          "editor_id"
        ]
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ai_design": {
          "type": "boolean"
        },
        "question_library": {
          "type": "boolean"
        }
      },
      "required": [
        "ai_design",
        "question_library"
      ]
    },
    "required_capability_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "protocol_version",
    "type_id",
    "type_version",
    "family",
    "title",
    "config_schema_id",
    "config_schema_version",
    "runtime_adapter_id",
    "editor_sections",
    "features",
    "required_capability_ids"
  ]
}
