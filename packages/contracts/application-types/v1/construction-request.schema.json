{
  "$id": "urn:campus:application-types:v1:construction-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_name": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Name"
    },
    "document_text": {
      "anyOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Text"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 80,
      "minLength": 16,
      "title": "Idempotency Key",
      "type": "string"
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "expected_revision",
    "text",
    "idempotency_key"
  ],
  "title": "GenerateConstruction",
  "type": "object"
}
