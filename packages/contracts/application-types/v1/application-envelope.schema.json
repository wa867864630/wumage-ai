{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:campus:application-types:v1:envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "envelope_version": {
      "const": "1.0.0"
    },
    "application_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "type_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "type_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      },
      "required": [
        "name",
        "description",
        "category"
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "student",
              "teacher",
              "config_admin"
            ]
          }
        }
      },
      "required": [
        "use_roles"
      ]
    },
    "bindings": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "allOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "config": {
      "type": "object"
    }
  },
  "required": [
    "envelope_version",
    "application_id",
    "type_id",
    "type_version",
    "metadata",
    "access",
    "bindings",
    "config"
  ]
}
