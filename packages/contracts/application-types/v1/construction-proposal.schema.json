{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "maximum": 500,
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "quote": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "line",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "$id": "urn:campus:application-types:v1:construction-proposal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Binding",
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 20,
      "title": "Evidence",
      "type": "array"
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Questions",
      "type": "array"
    },
    "status": {
      "enum": [
        "proposed",
        "needs_clarification"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "status",
    "binding",
    "summary",
    "questions",
    "content",
    "evidence"
  ],
  "title": "Proposal",
  "type": "object"
}
