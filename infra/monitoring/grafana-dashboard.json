{
  "title": "Campus MVP",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {"id": 1, "title": "Request rate", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "rate(campus_events_total{event=\"requests\"}[5m])", "refId": "A"}]},
    {"id": 2, "title": "P95 seconds", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, rate(campus_request_seconds_bucket[5m]))", "refId": "A"}]},
    {"id": 3, "title": "Outbox", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "campus_outbox_events", "refId": "A"}]},
    {"id": 4, "title": "Cache fallback errors", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "rate(campus_events_total{event=\"cache_errors\"}[5m])", "refId": "A"}]}
  ]
}
